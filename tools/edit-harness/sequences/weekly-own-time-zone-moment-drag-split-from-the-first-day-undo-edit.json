{
    "about": "Weekly on Tuesday at 08:00 New York time: one day given its own time (09:00), the zone changed to Tokyo with the same moment chosen (the series at that instant's clock there, 22:00, the own time keeping its instant, 23:00), a drag a day later (the own time moving with its occurrence), a rename \"this and following\" from the series' first day (the whole series' plan, api-contract This and following), Undo, then a time change after the undo and Undo again.",
    "series": {
        "family": "weekly_one",
        "rrule": "FREQ=WEEKLY;BYDAY=TU",
        "import": false,
        "bound": "none",
        "boundAt": 0,
        "untilForm": "dayend",
        "allDay": false,
        "tzid": "America/New_York",
        "start": "2027-02-02 08:00",
        "length": 60
    },
    "expect": {
        "zone": "America/New_York",
        "shows": [
            "2027-02-02 08:00 Sample series",
            "2027-02-09 08:00 Sample series",
            "2027-02-16 08:00 Sample series",
            "2027-02-23 08:00 Sample series"
        ]
    },
    "steps": [
        {
            "do": "this",
            "acted": "2027-02-09",
            "exception": {
                "own": [
                    "time"
                ],
                "mins": 60
            },
            "expect": {
                "zone": "America/New_York",
                "shows": [
                    "2027-02-02 08:00 Sample series",
                    "2027-02-09 09:00 Sample series",
                    "2027-02-16 08:00 Sample series",
                    "2027-02-23 08:00 Sample series"
                ]
            }
        },
        {
            "do": "edit",
            "acted": "2027-02-02",
            "vector": {
                "zone": "Asia/Tokyo"
            },
            "choices": {
                "zone": "moment"
            },
            "expect": {
                "zone": "Asia/Tokyo",
                "shows": [
                    "2027-02-02 22:00 Sample series",
                    "2027-02-09 23:00 Sample series",
                    "2027-02-16 22:00 Sample series",
                    "2027-02-23 22:00 Sample series"
                ]
            }
        },
        {
            "do": "edit",
            "acted": "2027-02-16",
            "vector": {
                "date": 1
            },
            "expect": {
                "zone": "Asia/Tokyo",
                "shows": [
                    "2027-02-03 22:00 Sample series",
                    "2027-02-10 23:00 Sample series",
                    "2027-02-17 22:00 Sample series",
                    "2027-02-24 22:00 Sample series"
                ]
            }
        },
        {
            "do": "edit",
            "acted": "2027-02-03",
            "vector": {
                "scope": "following",
                "fields": {
                    "title": "Sample series, renamed"
                }
            },
            "expect": {
                "zone": "Asia/Tokyo",
                "shows": [
                    "2027-02-03 22:00 Sample series, renamed",
                    "2027-02-10 23:00 Sample series, renamed",
                    "2027-02-17 22:00 Sample series, renamed",
                    "2027-02-24 22:00 Sample series, renamed"
                ]
            }
        },
        {
            "do": "undo",
            "expect": {
                "zone": "Asia/Tokyo",
                "shows": [
                    "2027-02-03 22:00 Sample series",
                    "2027-02-10 23:00 Sample series",
                    "2027-02-17 22:00 Sample series",
                    "2027-02-24 22:00 Sample series"
                ]
            }
        },
        {
            "do": "edit",
            "acted": "2027-02-17",
            "vector": {
                "clock": 3600
            },
            "expect": {
                "zone": "Asia/Tokyo",
                "shows": [
                    "2027-02-03 23:00 Sample series",
                    "2027-02-10 23:00 Sample series",
                    "2027-02-17 23:00 Sample series",
                    "2027-02-24 23:00 Sample series"
                ]
            }
        },
        {
            "do": "undo",
            "expect": {
                "zone": "Asia/Tokyo",
                "shows": [
                    "2027-02-03 22:00 Sample series",
                    "2027-02-10 23:00 Sample series",
                    "2027-02-17 22:00 Sample series",
                    "2027-02-24 22:00 Sample series"
                ]
            }
        }
    ]
}
