# Where scripts/deploy.sh and scripts/deploy-dev.sh ship to. Copy to
# scripts/deploy.env (ignored by git) and fill in. Real environment variables
# win over this file, so a one-off `REMOTE=other ./scripts/deploy.sh` works.

# ssh destination: a host alias from ~/.ssh/config, or user@host. The scripts
# run rsync and a few root commands there (chown, cron, symlink), so the
# login needs sudo.
REMOTE=myserver

# Unix user that owns the app and runs PHP.
APP_USER=bettercal

# The app's MySQL user (the value of BETTERCAL_DB_USER in the app's .env).
# Kept here, not read from the app's .env on the server: that file belongs
# to the web app, and the dev clone uses this name in a statement run as
# MySQL root. Letters, digits and underscores only.
DB_USER=bettercal

# Where the repository is copied to, and the web server's document root,
# which the script replaces with a symlink to ${APP_DIR}/server/public.
APP_DIR=/home/bettercal/app
DOCROOT=/home/bettercal/htdocs/cal.example.com

# Public health endpoint of the install; the deploy fails if it does not answer.
HEALTH_URL=https://cal.example.com/api/v1/health

# --- Dev instance (scripts/deploy-dev.sh only; optional) ----------------------
# A full second install on the same host: own directory, own database, own
# .env. The CLONE_DB=1 step copies the production database into the dev one
# using CloudPanel's clpctl for the MySQL root password; on a host without
# CloudPanel, set MYSQL_ROOT_PASSWORD instead.
DEV_DIR=/home/bettercal/dev
DEV_HEALTH_URL=https://cal.example.com:9443/api/v1/health
PROD_DB=bettercal
DEV_DB=bettercal_dev
