{
  "id": "s53-following-tags-people",
  "about": "\"This and following\" rename of a series with a tag and a person.",
  "expect151": "The new series takes the old one's tags and people.",
  "expectOld": "Old contract: split; tags and people not stated.",
  "steps": [
    {
      "do": "person",
      "as": "P1",
      "name": "Alex Example"
    },
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample standup",
        "start": "2027-01-05T17:00:00Z",
        "end": "2027-01-05T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=WEEKLY;BYDAY=TU;COUNT=6",
        "tagNames": [
          "sample-team"
        ],
        "people": [
          "P1"
        ]
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "following",
      "set": {
        "title": "Sample sync"
      },
      "on": "2027-01-19T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
