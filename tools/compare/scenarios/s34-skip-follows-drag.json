{
  "id": "s34-skip-follows-drag",
  "about": "A weekly series with a skipped 19 Jan dragged one day later from 12 Jan.",
  "expect151": "BYDAY=WE; the skip moves with its occurrence to 20 Jan.",
  "expectOld": "Old contract: skipped dates keep their places in the series when it moves with its repeat days unchanged; here the days change.",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample standup",
        "start": "2027-01-05T17:00:00Z",
        "end": "2027-01-05T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=WEEKLY;BYDAY=TU;COUNT=5"
      }
    },
    {
      "do": "delete",
      "event": "S",
      "scope": "this",
      "on": "2027-01-19T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "all",
      "set": {
        "start": "2027-01-13T17:00:00Z",
        "end": "2027-01-13T17:30:00Z"
      },
      "on": "2027-01-12T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
