{
    "about": "One day of a weekly series renamed here, then the whole series renamed at Google (Google writes the title into the day's record), not yet read, then the day's rename undone: asks, from series (Slice 3a, case 9; x-choice).",
    "series": {
        "family": "weekly_bare",
        "rrule": "FREQ=WEEKLY",
        "import": false,
        "bound": "count",
        "boundAt": 8,
        "untilForm": "dayend",
        "allDay": false,
        "tzid": "America/Los_Angeles",
        "start": "2027-03-01 10:00",
        "length": 60
    },
    "steps": [
        {
            "do": "w-this-g",
            "pick": 0.5,
            "what": "title",
            "mark": "d"
        },
        {
            "do": "r-rename",
            "pick": 0.1
        },
        {
            "do": "u-entry",
            "pick": 0,
            "entryOf": "d"
        }
    ]
}
