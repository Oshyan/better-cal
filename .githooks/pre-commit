#!/bin/sh
# Keeps the generated files in step with every commit that touches the web
# app: the modulepreload block in web/index.html and the service worker's
# shell list and VERSION in web/sw.js (scripts/gen-preload.mjs). Without this
# they were regenerated at deploy time, after the release commit, so the tag
# never matched what shipped. deploy.sh and web/tests/static.mjs still check,
# as a backstop for clones where this hook is not enabled.
#
# Enabled per clone with: git config core.hooksPath .githooks
#
# The files are generated from the working tree. If you commit only some of
# your web changes, the version reflects all of them; the static test will
# flag that on the commit, and the next commit that includes the rest fixes it.

root="$(git rev-parse --show-toplevel)" || exit 0

# Nothing under web/ staged: the generated files cannot have changed.
if git diff --cached --quiet -- web/; then
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, so web/sw.js and web/index.html were not regenerated (deploy will refuse a stale one)." >&2
  exit 0
fi

node "$root/scripts/gen-preload.mjs" >/dev/null || {
  echo "pre-commit: scripts/gen-preload.mjs failed; commit stopped." >&2
  exit 1
}
git add -- "$root/web/sw.js" "$root/web/index.html"
