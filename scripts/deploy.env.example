# Where scripts/deploy.sh and scripts/deploy-dev.sh ship to. Copy to
# scripts/deploy.env (ignored by git), fill in, then chmod 600 scripts/deploy.env.
# This file is the ONLY source of deployment configuration, also for
# push-settings.sh. Inherited REMOTE, APP_DIR, APP_USER, etc. are ignored.
# It must be an owned regular file (not a symlink), mode 0600 or 0400.
# Literal KEY=VALUE only: no export, shell quote wrappers, expansion, or inline
# comments. Password punctuation is literal, including spaces, quotes and =.
# Blank lines and comment lines are allowed; unknown/duplicate keys are errors.
# Paths must be canonical absolute paths using letters, digits, dots, underscores,
# hyphens and slashes: no spaces, Unicode, dot/dotdot components or trailing slash.
# Use SSH aliases or user@host; use an SSH alias for IPv6 or custom SSH options.
#
# One-off flags belong ONLY in the command environment, not this file:
# SKIP_TESTS=1, FORCE_BRANCH=1, CLONE_DB=1, MOVE_INTEGRITY_QUIESCED=1,
# FEED_CREDENTIALS_QUIESCED=1, SKIP_BACKUP=1. Each accepts 0 or 1.
# SKIP_BACKUP=1 requires typing "skip backup" at an interactive terminal.
# SSH_OPTS is internal to deploy-lib.sh; connection options belong in SSH config.

# ssh destination: a host alias from ~/.ssh/config, or user@host. The scripts
# create a root-private backup destination and use `sudo -n -u APP_USER` for
# application paths, rsync, migrations and cron, so the login needs passwordless
# sudo (or is root). All steps share one ssh connection (scripts/deploy-lib.sh).
REMOTE=myserver

# Unix user that owns the app and runs PHP.
APP_USER=bettercal

# The app's MySQL user (the value of BETTERCAL_DB_USER in the app's .env).
# Kept here, not read from the app's .env on the server: that file belongs
# to the web app, and the dev clone uses this name in a statement run as
# MySQL root. Letters, digits and underscores only.
DB_USER=bettercal

# Where the repository is copied to, and the web server's document root,
# which the script replaces with a symlink to ${APP_DIR}/server/public.
APP_DIR=/home/bettercal/app
DOCROOT=/home/bettercal/htdocs/cal.example.com

# Public health endpoint of the install; the deploy fails if it does not answer.
HEALTH_URL=https://cal.example.com/api/v1/health

# Service to stop briefly for a migration that explicitly requires a quiesced
# rollout. Ordinary deployments do not stop or inspect it.
PHP_FPM_SERVICE=php8.4-fpm

# Root-owned private backup directory. deploy.sh defaults to this value when it
# is omitted. For safety it must be one direct child of /home or /var/backups;
# the app user never owns or writes this directory.
BACKUP_DIR=/home/bettercal-backups

# Optional root-owned managed-plugin state directory (default shown).
# DEPLOY_STATE_ROOT=/var/lib/better-cal-deploy

# --- Dev instance (scripts/deploy-dev.sh only; optional) ----------------------
# A full second install on the same host: own directory, own database, own
# .env, served on its own port (replace PORT below). The CLONE_DB=1 step
# copies the production database into the dev one and needs the MySQL root
# password: set MYSQL_ROOT_PASSWORD, or on a CloudPanel host (one supported
# option) leave it unset and the script reads it with clpctl.
# MYSQL_ROOT_PASSWORD=
DEV_DIR=/home/bettercal/dev
DEV_HEALTH_URL=https://cal.example.com:PORT/api/v1/health
PROD_DB=bettercal
DEV_DB=bettercal_dev

# Recommended/default: a real containment boundary. Provision this Unix
# account, a dedicated PHP-FPM service/pool and a MySQL account with privileges
# only on DEV_DB. The two application users must not be able to read one
# another's .env files. The deploy verifies these database grants but never
# creates, locks, unlocks or rewrites database accounts.
DEV_ISOLATION_MODE=strict
DEV_APP_USER=bettercal-dev
DEV_DB_USER=bettercal_dev
DEV_PHP_FPM_SERVICE=php8.4-fpm-bettercal-dev

# Explicit lower-friction alternative: set DEV_ISOLATION_MODE=shared. The
# deploy warns on every run and permits the Unix user, DB user/password and
# PHP-FPM service to be shared. Any omitted DEV_* identity above then inherits
# its production value. Distinct paths, database names and session secrets are
# still required, and the live clone is sanitized before publication.

# Optional services configured in dev .env are disabled by default. Set this
# to enabled to test Google, mail, push, AI or mapping integrations; the deploy
# warns because external calls may have real side effects or cost. A database
# clone never copies Google connections or active plugin integration settings;
# reconnect/reconfigure those explicitly in dev. Receive-only ICS subscriptions
# are governed independently below.
DEV_EXTERNAL_SERVICES=disabled

# Receive-only ICS subscriptions survive CLONE_DB=1 by default, with their
# protected URLs re-encrypted for the distinct dev session secret. Set to strip
# to keep only inert local snapshots instead.
DEV_CLONE_SUBSCRIPTIONS=preserve

# Used only by CLONE_DB=1 to replace copied production password hashes before
# dev database access or PHP-FPM resumes. Keep the real value only in the
# gitignored scripts/deploy.env; it is sent over SSH stdin, never argv.
DEV_LOGIN_PASSWORD=
