{
  "id": "s06-allday-to-timed",
  "about": "A daily all-day series made timed (09:00 to 10:00 Los Angeles) from its second day.",
  "expect151": "Daily at 09:00 Los Angeles from Mon 11 Jan, COUNT 4, all_day 0.",
  "expectOld": "Same per the old contract (zone and time of day applied to the series).",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample focus day",
        "start": "2027-01-11",
        "end": "2027-01-12",
        "tzid": "America/Los_Angeles",
        "allDay": true,
        "rrule": "FREQ=DAILY;COUNT=4"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "all",
      "set": {
        "allDay": false,
        "start": "2027-01-12T17:00:00Z",
        "end": "2027-01-12T18:00:00Z",
        "tzid": "America/Los_Angeles"
      },
      "on": "2027-01-12"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
