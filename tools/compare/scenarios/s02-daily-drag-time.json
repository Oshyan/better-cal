{
  "id": "s02-daily-drag-time",
  "about": "Daily series dragged from its third day to 10:30 the same day.",
  "expect151": "Every day at 10:30 Los Angeles (18:30Z), start Mon 11 Jan at 10:30; COUNT 5 kept.",
  "expectOld": "Same: the new time of day applies to the series.",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample walk",
        "start": "2027-01-11T17:00:00Z",
        "end": "2027-01-11T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=DAILY;COUNT=5"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "all",
      "set": {
        "start": "2027-01-13T18:30:00Z",
        "end": "2027-01-13T19:00:00Z"
      },
      "on": "2027-01-13T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
