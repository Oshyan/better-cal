{
  "id": "s37-moved-day-kept",
  "about": "An edited day moved to its own date (12 Jan to 13 Jan); the series dragged a day later from 19 Jan.",
  "expect151": "movedDays group, preselected keep: the edited day stays on 13 Jan; the rest on Wednesdays.",
  "expectOld": "Old contract: edited occurrences keep their places in the series when it moves with its repeat days unchanged; here the days change.",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample standup",
        "start": "2027-01-05T17:00:00Z",
        "end": "2027-01-05T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=WEEKLY;BYDAY=TU;COUNT=6"
      }
    },
    {
      "do": "edit",
      "event": "S",
      "on": "2027-01-12T17:00:00Z",
      "scope": "this",
      "set": {
        "start": "2027-01-13T17:00:00Z",
        "end": "2027-01-13T17:30:00Z"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "all",
      "set": {
        "start": "2027-01-20T17:00:00Z",
        "end": "2027-01-20T17:30:00Z"
      },
      "on": "2027-01-19T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
