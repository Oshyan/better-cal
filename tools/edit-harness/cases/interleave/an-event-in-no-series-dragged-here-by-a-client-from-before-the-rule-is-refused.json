{
    "about": "An event in no series at 19:00 to 20:00 in Los Angeles, renamed at Google, then dragged an hour here by a client from before the rule: start and end alone in the body (no allDay, no zone), over the shown time whole. The time is not whole on a request carrying over, so it is refused: 400 client_outdated, nothing read from Google, nothing written here or there (x-choice; T2).",
    "series": {
        "family": "weekly_bare",
        "rrule": "FREQ=WEEKLY",
        "import": false,
        "bound": "count",
        "boundAt": 8,
        "untilForm": "dayend",
        "allDay": false,
        "tzid": "America/Los_Angeles",
        "start": "2027-03-01 10:00",
        "length": 60
    },
    "steps": [
        {
            "do": "w-create",
            "pick": 0.25,
            "single": true,
            "zone": "America/Los_Angeles",
            "clock": "19:00"
        },
        {
            "do": "r-single",
            "pick": 0.0,
            "fields": [
                "title"
            ],
            "same": []
        },
        {
            "do": "w-single",
            "pick": 0.0,
            "how": "edit",
            "fields": [
                "time"
            ],
            "shown": "earlier",
            "time": {
                "form": "drag",
                "days": 0,
                "secs": 3600,
                "zone": "UTC",
                "tz": "utc"
            },
            "outdated": "pair"
        },
        {
            "do": "w-single",
            "pick": 0.0,
            "how": "overwrite"
        }
    ]
}
