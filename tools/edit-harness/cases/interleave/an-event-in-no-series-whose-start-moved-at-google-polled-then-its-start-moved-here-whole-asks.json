{
    "about": "An event in no series at 15:00 to 16:00 in Kolkata (half an hour off the hour) whose start Google moved an hour earlier, polled while the person still saw 15:00 to 16:00, then given a start half an hour earlier here, sent whole with the shown end, allDay and its zone, over the shown time whole: the question's yours is exactly the time sent, in its zone, never an end that keeps the shown length (R2) or one from the row; Overwrite lands it with its zone (x-choice; the rule of 2026-11-14, T1, T2, T4).",
    "series": {
        "family": "weekly_bare",
        "rrule": "FREQ=WEEKLY",
        "import": false,
        "bound": "count",
        "boundAt": 8,
        "untilForm": "dayend",
        "allDay": false,
        "tzid": "America/Los_Angeles",
        "start": "2027-03-01 10:00",
        "length": 60
    },
    "steps": [
        {
            "do": "w-create",
            "pick": 0.2,
            "single": true,
            "zone": "Asia/Kolkata",
            "clock": "15:00"
        },
        {
            "do": "r-single",
            "pick": 0.0,
            "fields": [
                "time"
            ],
            "same": [],
            "time": {
                "how": "start",
                "days": 1,
                "zone": "UTC"
            }
        },
        {
            "do": "p-delta",
            "pick": 0.0
        },
        {
            "do": "w-single",
            "pick": 0.0,
            "how": "edit",
            "fields": [
                "time"
            ],
            "shown": "earlier",
            "time": {
                "form": "start",
                "days": 0,
                "secs": 1800,
                "zone": "UTC",
                "tz": "utc"
            }
        },
        {
            "do": "w-single",
            "pick": 0.0,
            "how": "overwrite"
        }
    ]
}
