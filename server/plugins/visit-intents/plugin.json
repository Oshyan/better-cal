{
  "id": "visit-intents",
  "name": "Visit Intents",
  "version": "0.1.0",
  "minHost": "0.1.0",
  "description": "Places you mean to go. Finds stretches where you are genuinely free and the place is actually open, and draws them on the calendar as opportunities. Links out to booking; never books anything.",
  "permissions": [
    "http",
    "ranges",
    "warnings",
    "geocode",
    "notify",
    "llm",
    "propose"
  ],
  "jobs": [
    {
      "id": "scan",
      "interval": "PT6H"
    }
  ],
  "decoration": {
    "icon": "star",
    "color": "#8a6fd4",
    "animation": "none"
  },
  "settings": [
    {
      "key": "wishlist",
      "type": "textarea",
      "rows": 10,
      "maxLength": 8000,
      "label": "Places I mean to visit — one per line: Name | Where | minutes | hours | before:YYYY-MM-DD | url:…",
      "default": ""
    },
    {
      "key": "horizonDays",
      "type": "number",
      "label": "Days ahead to look",
      "min": 3,
      "max": 60,
      "default": 21
    },
    {
      "key": "dayStart",
      "type": "number",
      "label": "Earliest hour I would head out",
      "min": 0,
      "max": 23,
      "default": 9
    },
    {
      "key": "dayEnd",
      "type": "number",
      "label": "Latest hour I would still be out",
      "min": 1,
      "max": 24,
      "default": 21
    },
    {
      "key": "minLeadHours",
      "type": "number",
      "label": "Ignore openings sooner than this (hours notice)",
      "min": 0,
      "max": 168,
      "default": 12
    },
    {
      "key": "bufferMinutes",
      "type": "number",
      "label": "Breathing room around existing events (minutes)",
      "min": 0,
      "max": 120,
      "default": 30
    },
    {
      "key": "maxPerPlace",
      "type": "number",
      "label": "Most opportunities to show per place",
      "min": 1,
      "max": 10,
      "default": 2
    },
    {
      "key": "allDayPolicy",
      "type": "select",
      "label": "Treat all-day events as time away",
      "options": [
        "away",
        "all",
        "none"
      ],
      "default": "away"
    },
    {
      "key": "weekendsOnly",
      "type": "toggle",
      "label": "Only suggest weekends",
      "default": false
    },
    {
      "key": "color",
      "type": "text",
      "label": "Band color (hex)",
      "default": "#8a6fd4"
    },
    {
      "key": "proposeTop",
      "type": "number",
      "label": "Also offer this many as one-click plans",
      "min": 0,
      "max": 5,
      "default": 1
    },
    {
      "key": "lookupHours",
      "type": "toggle",
      "label": "Look up missing hours from OpenStreetMap",
      "default": true
    },
    {
      "key": "notifyNew",
      "type": "toggle",
      "label": "Notify me when a genuinely new opportunity appears",
      "default": true
    }
  ],
  "calendarSettings": [
    {
      "key": "ignore",
      "type": "toggle",
      "label": "Ignore this calendar when judging whether I am free",
      "default": false
    }
  ],
  "eventSettings": [
    {
      "key": "notBusy",
      "type": "toggle",
      "label": "This event does not really block my time",
      "default": false
    }
  ]
}
