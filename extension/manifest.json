{
  "manifest_version": 3,
  "name": "Better-Cal: Google Calendar Link Redirect",
  "version": "2.1.0",
  "description": "Sends 'Add to Google Calendar' links to your own Better-Cal instead, and can open a new event there from a keyboard shortcut.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "new-event": {
      "description": "New event in Better-Cal"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
