{
    "name": "oshyan/better-cal-server",
    "description": "Better-Cal self-hosted calendar backend",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "minishlink/web-push": "^9.0",
        "phpmailer/phpmailer": "^6.9",
        "sabre/dav": "^4.7",
        "sabre/vobject": "^4.5",
        "webklex/php-imap": "^6.1"
    },
    "autoload": {
        "psr-4": {
            "BetterCal\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
