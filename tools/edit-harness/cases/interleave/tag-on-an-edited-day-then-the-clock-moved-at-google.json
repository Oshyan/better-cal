{
    "about": "A day with its own title and a tag; the series' clock moved at Google drops the record; a delta poll keeps the tag on the day's row at the new time (x-dropped).",
    "series": {
        "family": "weekly_bare",
        "rrule": "FREQ=WEEKLY",
        "import": false,
        "bound": "count",
        "boundAt": 8,
        "untilForm": "dayend",
        "allDay": false,
        "tzid": "America/Los_Angeles",
        "start": "2027-03-01 10:00",
        "length": 60
    },
    "steps": [
        {
            "do": "w-this-m",
            "pick": 0.3,
            "what": "title+tags"
        },
        {
            "do": "p-delta",
            "pick": 0.1
        },
        {
            "do": "r-time",
            "pick": 0.1
        },
        {
            "do": "p-delta",
            "pick": 0.1
        }
    ]
}
