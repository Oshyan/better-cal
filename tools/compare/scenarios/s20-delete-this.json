{
  "id": "s20-delete-this",
  "about": "Delete one occurrence (the second), then Undo.",
  "expect151": "Its key added to exdates; Undo removes it again.",
  "expectOld": "Same.",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample standup",
        "start": "2027-01-05T17:00:00Z",
        "end": "2027-01-05T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=WEEKLY;BYDAY=TU;COUNT=6"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "delete",
      "event": "S",
      "scope": "this",
      "on": "2027-01-12T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
