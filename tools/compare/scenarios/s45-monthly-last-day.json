{
  "id": "s45-monthly-last-day",
  "about": "Monthly on the last day (BYMONTHDAY=-1); February's dragged one day earlier.",
  "expect151": "Two readings, the nth-last day first: BYMONTHDAY=-2.",
  "expectOld": "Old (series-model table, MONTHLY from the end, Today): rule kept, start realigned, days lost or the drag ignored.",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample invoice",
        "start": "2027-01-31T17:00:00Z",
        "end": "2027-01-31T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=MONTHLY;BYMONTHDAY=-1;COUNT=4"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "all",
      "set": {
        "start": "2027-02-27T17:00:00Z",
        "end": "2027-02-27T17:30:00Z"
      },
      "on": "2027-02-28T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
