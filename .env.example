# Better-Cal configuration. Copy to `.env` in the app root (next to `server/`)
# and fill in. `.env` is never committed and is never overwritten by a deploy.
# Real environment variables win over this file. Every key is read in exactly
# one place: server/config/config.php.

# --- Required -----------------------------------------------------------------

# Public URL of this install, no trailing slash. Used for links in emails,
# cookie security, and the VAPID subject fallback.
BETTERCAL_BASE_URL=https://cal.example.com

BETTERCAL_DB_DSN=mysql:host=127.0.0.1;dbname=bettercal;charset=utf8mb4
BETTERCAL_DB_USER=bettercal
BETTERCAL_DB_PASS=

# Long random string, e.g. `openssl rand -hex 32`.
BETTERCAL_SESSION_SECRET=

# --- Sign-in protection (optional) ----------------------------------------------

# Wrong passwords are limited per network address, for the login form and
# CalDAV together: this many failures in 15 minutes, then that address waits.
# The account itself is never locked, and addresses you have signed in from
# before keep working even while many others are guessing.
BETTERCAL_LOGIN_MAX_FAILURES=10

# Leave EMPTY unless a reverse proxy or load balancer on a DIFFERENT address
# connects to PHP (Cloudflare, a separate nginx box, a container ingress). Then
# list its IPs or CIDR ranges, comma separated, so the visitor's real address is
# read from X-Forwarded-For. Without this the header is ignored, because anyone
# can send it. A web server on the same machine handing requests to PHP-FPM
# needs nothing here. Symptom of a missing entry: every visitor shares one
# limit, because they all appear to come from the proxy.
BETTERCAL_TRUSTED_PROXIES=

# --- Work budgets (optional) -----------------------------------------------------

# How much the app takes in one go from input someone else wrote: a feed, an
# emailed invitation, an imported file, a CalDAV client. The defaults are far
# above what a real calendar produces; they exist so a hostile or broken input
# fails with a message instead of taking the worker or the import down. Set one
# only if a legitimate input of yours is being refused. Values are whole
# numbers; anything below 1 is ignored. (server/src/Support/Limits.php)
#
# BETTERCAL_LIMIT_JSON_BODY_BYTES=1048576   # one JSON API request (1 MiB; hard ceiling 4 MiB)
# BETTERCAL_LIMIT_IMPORT_BYTES=26214400      # an uploaded .ics file (25 MiB)
# BETTERCAL_LIMIT_IMPORT_EVENTS=20000        # events in one import; also capped by PHP memory_limit
# BETTERCAL_LIMIT_TAKEOUT_FILES=1000         # .ics files admitted by one command-line Takeout import (hard ceiling 5000)
# BETTERCAL_LIMIT_TAKEOUT_TOTAL_BYTES=1073741824 # all admitted Takeout files together (1 GiB; hard ceiling 4 GiB)
# BETTERCAL_LIMIT_FEED_EVENTS=20000          # events one subscribed feed may hold per poll; also capped by memory_limit
# BETTERCAL_LIMIT_GOOGLE_SYNC_EVENTS=20000   # Google resources per poll/retry; also capped by memory (hard ceiling 50000)
# BETTERCAL_LIMIT_GOOGLE_SYNC_BYTES=33554432 # all decoded Google event pages together (32 MiB; hard ceiling 64 MiB)
# BETTERCAL_LIMIT_GOOGLE_SYNC_PAGES=20       # event pages including a stale-token retry (hard ceiling 60)
# BETTERCAL_LIMIT_GOOGLE_SYNC_SECONDS=40     # complete Google poll, including local application (hard ceiling 45)
# BETTERCAL_LIMIT_GOOGLE_CALENDAR_LIST_ITEMS=5000 # calendars one account may enumerate (hard ceiling 10000)
# BETTERCAL_LIMIT_GOOGLE_CALENDAR_LIST_BYTES=5242880 # all calendar-list pages together (5 MiB; hard ceiling 20 MiB)
# BETTERCAL_LIMIT_GOOGLE_CALENDAR_LIST_PAGES=20 # calendar-list pages (hard ceiling 60)
# BETTERCAL_LIMIT_GOOGLE_CALENDAR_LIST_SECONDS=20 # one calendar-list operation (hard ceiling 30)
# BETTERCAL_LIMIT_OUTFEED_EVENTS=5000        # events one feed you publish holds; past ones nearest today are kept first
# BETTERCAL_LIMIT_OUTFEED_BYTES=16777216      # complete generated .ics feed (16 MiB; hard ceiling 32 MiB)
# BETTERCAL_LIMIT_OUTFEED_RELATIONS=20000     # trip relationships serialized into one feed (hard ceiling 50000)
# BETTERCAL_LIMIT_EXPANSION_SERIES=5000       # repeating series visited by one request/worker operation (hard ceiling 10000)
# BETTERCAL_LIMIT_EXPANSION_OCCURRENCES=10000 # generated occurrences in one operation (hard ceiling 25000)
# BETTERCAL_LIMIT_EXPANSION_SECONDS=8         # recurrence work in one operation (hard ceiling 15 seconds)
# BETTERCAL_LIMIT_EVENT_WINDOW_BYTES=33554432 # stored text/JSON admitted into one event window (32 MiB; hard ceiling 64 MiB)
# BETTERCAL_LIMIT_RECURRENCE_MUTATION_HORIZON_DAYS=7305 # edit one generated occurrence within about 20 years of today (hard ceiling about 50 years)
# BETTERCAL_LIMIT_PLUGIN_WINDOW_EVENTS=5000   # occurrences one plugin may read at once (hard ceiling 10000)
# BETTERCAL_LIMIT_PLUGIN_SYNC_EVENTS=2000     # complete event snapshot one plugin may replace (hard ceiling 5000)
# BETTERCAL_LIMIT_PLUGIN_SYNC_BYTES=8388608   # scalar event data in one plugin snapshot (8 MiB; hard ceiling 16 MiB)
# BETTERCAL_LIMIT_PLUGIN_MANUAL_RUNS_PER_HOUR=30 # newly queued manual plugin jobs per account (hard ceiling 120)
# BETTERCAL_LIMIT_PLUGIN_MANUAL_RUNS_PER_DAY=100 # newly queued manual plugin jobs per account (hard ceiling 500)
# BETTERCAL_LIMIT_PLUGIN_ACTIVE_JOBS=16       # pending/running plugin job identities install-wide (hard ceiling 64)
# BETTERCAL_LIMIT_DAV_OBJECT_BYTES=1048576   # one CalDAV object (1 MiB), published as max-resource-size
# BETTERCAL_LIMIT_DAV_OVERRIDES=500          # changed occurrences inside one CalDAV object
# BETTERCAL_LIMIT_MAIL_BYTES=5242880         # one incoming email (5 MiB); larger ones are never downloaded
# BETTERCAL_LIMIT_MAIL_ICS_BYTES=1048576     # one calendar part of an email
# BETTERCAL_LIMIT_MAIL_ICS_EVENTS=200        # events in an emailed invitation
# BETTERCAL_LIMIT_MAIL_BODY_CHARS=524288     # email text handed to markup and LLM extraction
# BETTERCAL_LIMIT_MAIL_EVENTS_PER_DAY=100     # new events created from public mail in any rolling 24 hours (hard ceiling 500)
# BETTERCAL_LIMIT_MAIL_EVENTS_PER_SENDER_DAY=25 # secondary fairness brake; From is spoofable (hard ceiling 100)
# BETTERCAL_LIMIT_MAIL_ACTIVE_EVENTS=500      # future/repeating events created from mail (hard ceiling 2000)
# BETTERCAL_LIMIT_MAIL_PENDING_INVITATIONS=100 # open emailed invitation decisions in Review (hard ceiling 100)
# BETTERCAL_LIMIT_MAIL_LLM_PER_HOUR=20        # paid mail-reading model calls in a rolling hour (hard ceiling 100)
# BETTERCAL_LIMIT_MAIL_LLM_PER_DAY=50         # paid mail-reading model calls in 24 hours (hard ceiling 250)
# BETTERCAL_LIMIT_MAIL_LLM_PER_SENDER_DAY=20  # secondary fairness brake (hard ceiling 100)
# BETTERCAL_LIMIT_MAIL_LOG_RETENTION_DAYS=90  # replay receipts and admission accounting (hard ceiling 365)
# BETTERCAL_LIMIT_NOTIFY_EMAILS_PER_CYCLE=50  # reminder emails in one durable scan cycle (hard ceiling 250)
# BETTERCAL_LIMIT_NOTIFY_EMAILS_PER_ACCOUNT_HOUR=100 # reminder/ad-hoc notification emails per account (hard ceiling 500)
# BETTERCAL_LIMIT_NOTIFY_EMAILS_PER_ACCOUNT_DAY=500  # rolling day per account (hard ceiling 2000)
# BETTERCAL_LIMIT_NOTIFY_EMAILS_PER_RECIPIENT_HOUR=50 # secondary normalized-recipient limit (hard ceiling 250)
# BETTERCAL_LIMIT_NOTIFY_EMAILS_PER_RECIPIENT_DAY=200 # rolling day per account/recipient (hard ceiling 1000)
# BETTERCAL_LIMIT_NOTIFY_EMAILS_PER_INSTALL_HOUR=200  # whole installation (hard ceiling 1000)
# BETTERCAL_LIMIT_NOTIFY_EMAILS_PER_INSTALL_DAY=1000  # whole installation (hard ceiling 5000)
# BETTERCAL_LIMIT_MODEL_QUICKADD_CHARS=4000     # plain-language Quick Add text (hard ceiling 16000)
# BETTERCAL_LIMIT_MODEL_QUICKADD_PER_HOUR=120  # Quick Add model assists account-wide (hard ceiling 500)
# BETTERCAL_LIMIT_MODEL_QUICKADD_PER_DAY=500   # account-wide rolling 24 hours (hard ceiling 2000)
# BETTERCAL_LIMIT_MODEL_QUICKADD_PER_TOKEN_HOUR=30 # one API token's hourly share (hard ceiling 120)
# BETTERCAL_LIMIT_MODEL_QUICKADD_PER_TOKEN_DAY=150 # one API token's daily share (hard ceiling 500)
# BETTERCAL_LIMIT_MODEL_QUICKADD_CONCURRENT=4  # active assists account-wide (hard ceiling 12)
# BETTERCAL_LIMIT_MODEL_QUICKADD_PER_TOKEN_CONCURRENT=2 # active assists for one API token (hard ceiling 6)
# BETTERCAL_LIMIT_MODEL_FILTER_PER_HOUR=40      # prompt-filter batches account-wide (hard ceiling 200)
# BETTERCAL_LIMIT_MODEL_FILTER_PER_DAY=200      # prompt-filter batches in 24 hours (hard ceiling 1000)
# BETTERCAL_LIMIT_MODEL_FILTER_PER_CALENDAR_HOUR=20 # one calendar's hourly share (hard ceiling 100)
# BETTERCAL_LIMIT_MODEL_FILTER_PER_CALENDAR_DAY=100 # one calendar's daily share (hard ceiling 500)
# BETTERCAL_LIMIT_MODEL_RESPONSE_BYTES=1048576 # one streamed Gemini response (1 MiB; hard ceiling 4 MiB)
# BETTERCAL_LIMIT_MODEL_LOG_RETENTION_DAYS=90   # non-mail model admission accounting (hard ceiling 365)
# BETTERCAL_LIMIT_EXDATE_VALUES_PER_EVENT=1024 # skipped occurrences one event may carry (hard ceiling 2048)
# BETTERCAL_LIMIT_EXDATE_VALUES_PER_INPUT=4096 # skipped occurrences in one file/sync batch (hard ceiling 8192)
# BETTERCAL_LIMIT_DESCRIPTION_CHARS=65535    # kept per event description; longer ones are cut
# BETTERCAL_LIMIT_URL_CHARS=2048             # kept per event URL
# BETTERCAL_LIMIT_REGEX_EVALS=20000          # regex filter evaluations per request

# --- Web Push reminders (optional) ---------------------------------------------

# Generate with `php server/bin/vapid.php --generate`. Subject is a mailto: or
# https: URL identifying the operator to push services.
BETTERCAL_VAPID_PUBLIC=
BETTERCAL_VAPID_PRIVATE=
BETTERCAL_VAPID_SUBJECT=mailto:you@example.com

# Push endpoints are only accepted from the browser push services (Google FCM,
# Mozilla, Apple, Windows). If a browser you use hands out endpoints on another
# host, list it here, comma separated; each entry also matches its subdomains.
# Leave empty unless a subscription is refused with "not a recognized push
# service".
BETTERCAL_PUSH_EXTRA_HOSTS=

# --- Email (optional) -----------------------------------------------------------

# SMTP relay for reminder and alert email. Host + from are the minimum.
BETTERCAL_SMTP_HOST=
BETTERCAL_SMTP_PORT=587
BETTERCAL_SMTP_USER=
BETTERCAL_SMTP_PASS=
BETTERCAL_SMTP_FROM=

# Where system-wide failure alerts go. Empty means the first user.
BETTERCAL_ALERT_EMAIL=

# Mailbox polled for forwarded invitations (docs/email-ingest.md). Each value
# defaults to the matching SMTP value above, port 993.
BETTERCAL_IMAP_HOST=
BETTERCAL_IMAP_PORT=993
BETTERCAL_IMAP_USER=
BETTERCAL_IMAP_PASS=

# Second SMTP profile for RSVP replies, so they come from the address that was
# actually invited. Falls back to the main SMTP profile when empty.
BETTERCAL_RSVP_SMTP_HOST=
BETTERCAL_RSVP_SMTP_PORT=587
BETTERCAL_RSVP_SMTP_USER=
BETTERCAL_RSVP_SMTP_PASS=
BETTERCAL_RSVP_SMTP_FROM=

# --- Integrations (optional) ----------------------------------------------------

# LLM for natural-language add, prompt filters and ranking.
BETTERCAL_GEMINI_API_KEY=
BETTERCAL_GEMINI_MODEL=

# MapTiler tiles for the event mini-map. Empty keeps plain OpenStreetMap tiles.
BETTERCAL_MAPTILER_KEY=

# Place search for the location dropdown. Empty or photon: photon.komoot.io,
# free and keyless. locationiq or stadia: that service with its key below,
# with Photon answering whatever it can't (and whenever it fails). Settings,
# Location & maps shows which one is in use. docs/geocoding.md compares them.
BETTERCAL_PLACE_SEARCH=
# Placing events nobody picked a place for (imports, feeds, typed text): the
# same choices, asked before Photon. Empty: whatever BETTERCAL_PLACE_SEARCH is.
BETTERCAL_PLACE_LOOKUP=
# LocationIQ (locationiq.com). If you restrict the key to source addresses,
# LocationIQ accepts only IPv4 ones, so Better-Cal reaches it over IPv4.
BETTERCAL_LOCATIONIQ_KEY=
# Stadia Maps (stadiamaps.com). Better-Cal saves the coordinates of places you
# pick. Stadia Maps' terms allow keeping them only on a paid plan that
# includes storing results, so check Stadia's current plans. Making sure your
# plan fits is your responsibility; Better-Cal does not check.
BETTERCAL_STADIA_KEY=

# Google Calendar connector (docs/google-calendar.md). Each install needs its
# own OAuth client from Google Cloud; the setup there takes about ten minutes.
# Both empty: Settings, Connections says the connector is not set up.
BETTERCAL_GOOGLE_CLIENT_ID=
BETTERCAL_GOOGLE_CLIENT_SECRET=
