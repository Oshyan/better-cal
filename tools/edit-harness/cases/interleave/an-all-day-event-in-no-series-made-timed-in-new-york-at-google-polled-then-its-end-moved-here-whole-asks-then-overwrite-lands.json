{
    "about": "The second outside read's R1, sent as the rule has it: an all-day event of 3 to 5 March 2027 made timed at 18:00 to 19:00 in New York at Google and polled while the person still saw it all-day, then given an end a day later here, sent whole (start and end as dates, allDay, zone) over the shown time whole: the question's yours is 3 to 7 March exclusive, its start where it was shown, never a day earlier through the zone west of UTC; Overwrite lands it (x-choice; T1, T4).",
    "series": {
        "family": "weekly_bare",
        "rrule": "FREQ=WEEKLY",
        "import": false,
        "bound": "count",
        "boundAt": 8,
        "untilForm": "dayend",
        "allDay": false,
        "tzid": "America/Los_Angeles",
        "start": "2027-03-01 10:00",
        "length": 60
    },
    "steps": [
        {
            "do": "w-create",
            "pick": 0.15,
            "single": true,
            "allDay": 3,
            "zone": "UTC",
            "clock": "15:00"
        },
        {
            "do": "r-single",
            "pick": 0.0,
            "fields": [
                "time"
            ],
            "same": [],
            "time": {
                "how": "kind",
                "days": 1,
                "zone": "America/New_York"
            }
        },
        {
            "do": "p-delta",
            "pick": 0.0
        },
        {
            "do": "w-single",
            "pick": 0.0,
            "how": "edit",
            "fields": [
                "time"
            ],
            "shown": "earlier",
            "time": {
                "form": "resize",
                "days": 0,
                "secs": 0,
                "zone": "UTC",
                "tz": "utc"
            }
        },
        {
            "do": "w-single",
            "pick": 0.0,
            "how": "overwrite"
        }
    ]
}
