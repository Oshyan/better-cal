# Better-Cal configuration. Copy to `.env` in the app root (next to `server/`)
# and fill in. `.env` is never committed and is never overwritten by a deploy.
# Real environment variables win over this file. Every key is read in exactly
# one place: server/config/config.php.

# --- Required -----------------------------------------------------------------

# Public URL of this install, no trailing slash. Used for links in emails,
# cookie security, and the VAPID subject fallback.
BETTERCAL_BASE_URL=https://cal.example.com

BETTERCAL_DB_DSN=mysql:host=127.0.0.1;dbname=bettercal;charset=utf8mb4
BETTERCAL_DB_USER=bettercal
BETTERCAL_DB_PASS=

# Long random string, e.g. `openssl rand -hex 32`.
BETTERCAL_SESSION_SECRET=

# --- Sign-in protection (optional) ----------------------------------------------

# Wrong passwords are limited per network address, for the login form and
# CalDAV together: this many failures in 15 minutes, then that address waits.
# The account itself is never locked, and addresses you have signed in from
# before keep working even while many others are guessing.
BETTERCAL_LOGIN_MAX_FAILURES=10

# Leave EMPTY unless a reverse proxy or load balancer on a DIFFERENT address
# connects to PHP (Cloudflare, a separate nginx box, a container ingress). Then
# list its IPs or CIDR ranges, comma separated, so the visitor's real address is
# read from X-Forwarded-For. Without this the header is ignored, because anyone
# can send it. A web server on the same machine handing requests to PHP-FPM
# needs nothing here. Symptom of a missing entry: every visitor shares one
# limit, because they all appear to come from the proxy.
BETTERCAL_TRUSTED_PROXIES=

# --- Web Push reminders (optional) ---------------------------------------------

# Generate with `php server/bin/vapid.php --generate`. Subject is a mailto: or
# https: URL identifying the operator to push services.
BETTERCAL_VAPID_PUBLIC=
BETTERCAL_VAPID_PRIVATE=
BETTERCAL_VAPID_SUBJECT=mailto:you@example.com

# Push endpoints are only accepted from the browser push services (Google FCM,
# Mozilla, Apple, Windows). If a browser you use hands out endpoints on another
# host, list it here, comma separated; each entry also matches its subdomains.
# Leave empty unless a subscription is refused with "not a recognized push
# service".
BETTERCAL_PUSH_EXTRA_HOSTS=

# --- Email (optional) -----------------------------------------------------------

# SMTP relay for reminder and alert email. Host + from are the minimum.
BETTERCAL_SMTP_HOST=
BETTERCAL_SMTP_PORT=587
BETTERCAL_SMTP_USER=
BETTERCAL_SMTP_PASS=
BETTERCAL_SMTP_FROM=

# Where system-wide failure alerts go. Empty means the first user.
BETTERCAL_ALERT_EMAIL=

# Mailbox polled for forwarded invitations (docs/email-ingest.md). Each value
# defaults to the matching SMTP value above, port 993.
BETTERCAL_IMAP_HOST=
BETTERCAL_IMAP_PORT=993
BETTERCAL_IMAP_USER=
BETTERCAL_IMAP_PASS=

# Second SMTP profile for RSVP replies, so they come from the address that was
# actually invited. Falls back to the main SMTP profile when empty.
BETTERCAL_RSVP_SMTP_HOST=
BETTERCAL_RSVP_SMTP_PORT=587
BETTERCAL_RSVP_SMTP_USER=
BETTERCAL_RSVP_SMTP_PASS=
BETTERCAL_RSVP_SMTP_FROM=

# --- Integrations (optional) ----------------------------------------------------

# LLM for natural-language add, prompt filters and ranking.
BETTERCAL_GEMINI_API_KEY=
BETTERCAL_GEMINI_MODEL=

# MapTiler tiles for the event mini-map. Empty keeps plain OpenStreetMap tiles.
BETTERCAL_MAPTILER_KEY=
