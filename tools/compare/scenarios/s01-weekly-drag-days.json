{
  "id": "s01-weekly-drag-days",
  "about": "Whole-series drag of a weekly Tuesday series from its third occurrence by one day.",
  "expect151": "Every occurrence moves one day later (BYDAY=WE), the start to Wed 6 Jan; COUNT stays 6.",
  "expectOld": "Same: a weekly BYDAY shifts with the dragged day (api-contract PATCH, scope all with instanceStart).",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample standup",
        "start": "2027-01-05T17:00:00Z",
        "end": "2027-01-05T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=WEEKLY;BYDAY=TU;COUNT=6"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "all",
      "set": {
        "start": "2027-01-20T17:00:00Z",
        "end": "2027-01-20T17:30:00Z"
      },
      "on": "2027-01-19T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
