{
  "id": "s07-timed-to-allday",
  "about": "A weekly timed series made all-day from its second occurrence.",
  "expect151": "All-day every Monday from 11 Jan, COUNT 4.",
  "expectOld": "Same per the old contract.",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample review",
        "start": "2027-01-11T17:00:00Z",
        "end": "2027-01-11T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=WEEKLY;BYDAY=MO;COUNT=4"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "edit",
      "event": "S",
      "scope": "all",
      "set": {
        "allDay": true,
        "start": "2027-01-18",
        "end": "2027-01-19"
      },
      "on": "2027-01-18T17:00:00Z"
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
