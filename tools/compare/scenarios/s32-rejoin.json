{
  "id": "s32-rejoin",
  "about": "An edited day (own title) given the series' title back.",
  "expect151": "Use series value: the day has nothing of its own, its row is removed, an ordinary occurrence again.",
  "expectOld": "Old contract has no \"use series value\"; the runner sends the series' title with scope this, which keeps an override row.",
  "steps": [
    {
      "do": "create",
      "as": "S",
      "event": {
        "title": "Sample standup",
        "start": "2027-01-05T17:00:00Z",
        "end": "2027-01-05T17:30:00Z",
        "tzid": "America/Los_Angeles",
        "rrule": "FREQ=WEEKLY;BYDAY=TU;COUNT=6"
      }
    },
    {
      "do": "edit",
      "event": "S",
      "on": "2027-01-19T17:00:00Z",
      "scope": "this",
      "set": {
        "title": "Sample standup demo"
      }
    },
    {
      "do": "snapshot",
      "name": "before"
    },
    {
      "do": "rejoin",
      "event": "S",
      "on": "2027-01-19T17:00:00Z",
      "fields": [
        "title"
      ],
      "values": {
        "title": "Sample standup"
      }
    },
    {
      "do": "snapshot",
      "name": "after"
    },
    {
      "do": "undo"
    },
    {
      "do": "snapshot",
      "name": "undone",
      "journal": true
    }
  ]
}
