{
  "id": "weather",
  "name": "Weather",
  "version": "1.0.0",
  "minHost": "0.1.0",
  "description": "Daily forecast via Open-Meteo (free, no API key): one all-day event per day with an icon for the conditions and the high and low, plus the day's air quality (US AQI) when enabled. Add a weather calendar for each place, or one that follows another calendar's place. Severe weather and unhealthy air raise warnings.",
  "permissions": [
    "http",
    "events:write",
    "warnings"
  ],
  "jobs": [
    {
      "id": "refresh",
      "interval": "PT3H",
      "runOnSave": true
    }
  ],
  "ownCalendars": {
    "noun": "weather calendar",
    "name": "Weather, {location}",
    "color": "#5b8dd9",
    "role": "context",
    "max": 20
  },
  "ownCalendarSettings": [
    {
      "key": "location",
      "type": "location",
      "label": "Place",
      "required": true
    },
    {
      "key": "units",
      "type": "select",
      "label": "Units",
      "options": [
        "F",
        "C"
      ],
      "default": "F"
    },
    {
      "key": "days",
      "type": "number",
      "label": "Forecast days",
      "min": 1,
      "max": 14,
      "default": 10
    },
    {
      "key": "airQuality",
      "type": "toggle",
      "label": "Include air quality (AQI)",
      "default": true
    }
  ],
  "decoration": {
    "icon": "⛅"
  }
}
